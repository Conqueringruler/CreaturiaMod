Mods: {
	Creaturia: {
		Buffs: {
			BabyLumpsuckerBuff: {
				DisplayName: Детеныш Пинагор
				Description: Детеныш пинагора сражается за вас!
			}

			DunkleBuff: {
				DisplayName: Темный дух
				Description:
					'''
					Мощное увеличение физической силы, но предметы не могут быть использованы
					Защита увеличивается на 50. Выносливость увеличивается на 5%, Скорость передвижения увеличивается на 10%
					'''
			}

			FishmanBuff: {
				DisplayName: Благославение рыбака
				Description: Мощное увеличение скорости передвежения и атаки ближнего боя and melee speed, and amplifies your senses!
			}

			SlipperyBuff: {
				DisplayName: Скользский
				Description: Шанс 50% увернуться от атаки, когда ты скользкий!
			}
		}

		Items: {
			RabbitsFoot: {
				DisplayName: Крольчья лапка
				Tooltip:
					'''
					'Они сказали, что это удача... Я сказал, что это стремно.' 
					Немного увеличивает удачу
					Шанс 1% увернуться от атаки
					'''
			}

			SpinyNecklace: {
				DisplayName: Шипастое ожерелье
				Tooltip:
					'''
					Увеличивает максимальное значение миньонов на 1
					Детеныш Пинагора принял вас за свое мать
					'''
			}

			FishBullet: {
				DisplayName: Рыбопуля
				Tooltip:
					'''
					Превращается в пулю, когда в находится в воде или под дождем!
					Когда превращена, +5% к крит. урону 
					Когда превращена, мощно усилена отдача
					Когда превращена, самоноводится
					'''
			}

			AncientDartGunPieces.DisplayName: Части древнего дротикомета
			SinfulSoil.DisplayName: Грешная почва

			BundleOfCoral: {
				DisplayName: Мешок коралов
				Tooltip:
					'''
					Много ракушек и вещиц лежит внутри!
					{$CommonItemTooltip.RightClickToOpen}
					'''
			}

			BundleOfFishBullets: {
				DisplayName: Мешок рыбопуль
				Tooltip:
					'''
					Содержит 10-20 рыбопуль
					{$CommonItemTooltip.RightClickToOpen}
					'''
			}

			CorruptBait: {
				DisplayName: Гнилая наживка
				Tooltip:
					'''
					'!'
					Используйте в порче
					'''
			}

			CrimsonBait: {
				DisplayName: Гнойный стейк
				Tooltip:
					'''
					'!'
					Используйте в багрянце
					'''
			}

			FishmanDevbait: {
				DisplayName: Рыбный червь
				Tooltip:
					'''
					'Только для разработчиков!' 
					Используйте в океане
					'''
			}

			GoldenFishDevBait: {
				DisplayName: Магический червь
				Tooltip:
					'''
					'От него исходит энергетическая аура, не устрашающая вас' 
					Используйте в океане
					'''
			}

			HallowBait: {
				DisplayName: Сверкающий леденец
				Tooltip:
					'''
					'!' 
					Используете в освещении
					'''
			}

			DunkleVertebrae: {
				DisplayName: Позвонок дунклеостея
				Tooltip: "'Ее плотность делает его практически неразрушимым'"
			}

			ExampleSword: {
				DisplayName: Тестовый меч
				Tooltip: Каждый мод нуждается в старте с тестовым мечем.
			}

			HellborneIcon: {
				DisplayName: Адский череп и голем слабы для этого оружия слабы для этого оружия!
				Tooltip: "эмм... тебе нельзя видеть эту подсказку! "
			}

			LumpsuckerHeart: {
				DisplayName: Гнойные шипы
				Tooltip: "'Несмотря на то, что шипы чистые, как бритва, они все воняют'"
			}

			MoltenBone.DisplayName: Расплавленная кость

			RainbowScale2: {
				DisplayName: Радужная чешуя
				Tooltip: Призматические цвета завораживают!
			}

			SummonFallen: {
				DisplayName: Призыв упавшей феи
				Tooltip: "'Эй, это только для разработчиков!' НЕДОСТУПЕН"
			}

			SlipperyHook: {
				DisplayName: Склизкий крюк
				Tooltip:
					'''
					Шанс 50% отразить атаку, пока цепляешься крюком'
					'Повсюду слизь!'
					'''
			}

			AncientDartRifle: {
				DisplayName: Древний дротикомет
				Tooltip:
					'''
					'Древний' 
					Очень точный, медленный
					'''
			}

			AncientStoneShortsword: {
				DisplayName: Древний каменный короткий меч
				Tooltip: "'Похоже, он рассыпится от одного удара'"
			}

			ElectricEel: {
				DisplayName: Электрический угорь
				Tooltip:
					'''
					Ваши призванные существа будут стараться атаковать врагов
					Шанс 100% электреризировать врагов на 2,5 без зарядки и на 5 секунд с зарядкой
					Зарядка увеличивает длину кнута в 2 раза
					'''
			}

			FlagrantEyeball: {
				DisplayName: Ужасающий глаз
				Tooltip:
					'''
					"'Это глаз пииинагора'"
					'Прототип вырезанного оружия.'
					'''
			}

			RainbowFocus: {
				DisplayName: Радужное благославление
				Tooltip:
					'''
					'Благославить только тех, у кого большая сила' 
					Прверащает ману в здоровье в зависимости от одетых магических вещей
					Нажмите ПКМ, для мощно востановить здоровье за 400 ед.маны ,востанавливается после 6 обыкновенным исцелений
					'''
			}

			ScaledLamp: {
				DisplayName: Позвоночная лампа
				Tooltip:
					'''
					'Кости делают лампу почти неразрушимой' 
					Зажми, чтобы призвать призрака и силу дунклеостея
					Предметы и призывы не могут быть использованы во время использования лампы
					'''
			}

			TridentoftheFishman: {
				DisplayName: Трезубец рыбака
				Tooltip:
					'''
					Шанс призвать призрачный трезубец, атакующий врагов
					 Нажмите ПКМ, чтобы вызвать его благословление. 
					Усиляется, когда мокрый
					'с божественным трезубцем'
					'''
			}

			HoopSnakeItem: {
				DisplayName: Кольцезмей
				Tooltip: "'Террарианы долго жили в страхе перед кольцезмеем.'"
