			RainbowFocus: {
				DisplayName: Радужное благославление
				Tooltip:
					'''
					'Благославить только тех, у кого большая сила' 
					Прверащает ману в здоровье в зависимости от одетых магических вещей
					Нажмите ПКМ, для мощно востановить здоровье за 400 ед.маны ,востанавливается после 6 обыкновенным исцелений
					'''
			}

			ScaledLamp: {
				DisplayName: Позвоночная лампа
				Tooltip:
